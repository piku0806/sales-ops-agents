# "mock" runs fully offline. "azure" uses a model deployed in your Microsoft Foundry project.
LLM_PROVIDER=mock

# From Foundry portal -> your project -> Models + endpoints -> your deployment
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave blank to use Microsoft Entra ID (run `az login` first). Keyless auth is the recommended setup.
AZURE_OPENAI_API_KEY=
